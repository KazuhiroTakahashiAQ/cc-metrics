  "editable": true,
  "id": null,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "User Prompt Events",
      "description": "ユーザーがClaude Codeに送信したプロンプト数の推移（event_name=user_prompt）。スラッシュコマンドを含む全入力イベントを集計。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"claude-code.*\"} | event_name=\"user_prompt\" [$__rate_interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Skill Activations by Skill",
      "description": "スキル名（skill_name）別の起動回数の推移（event_name=skill_activated）。どのスキルが最も頻繁に使われているか把握できる。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (skill_name) (count_over_time({service_name=~\"claude-code.*\"} | event_name=\"skill_activated\" [$__rate_interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tool Results by Tool",
      "description": "ツール名（tool_name）別の実行結果受信数の推移（event_name=tool_result）。Bash / Read / Edit など各ツールの利用頻度を確認できる。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool_name) (count_over_time({service_name=~\"claude-code.*\"} | event_name=\"tool_result\" [$__rate_interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "GitHub Issue MCP Tool Events",
      "description": "名称に「issue」を含むMCPツールの実行数推移（mcp_tool_name で正規表現フィルタ）。Issue の List / Get / Create 等の操作頻度を追跡できる。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mcp_tool_name) (count_over_time({service_name=~\"claude-code.*\"} | event_name=\"tool_result\" | mcp_tool_name=~\"(?i).*issue.*\" [$__rate_interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Average Prompt Length",
      "description": "ユーザープロンプトの平均文字数の推移（prompt_length フィールドの avg_over_time）。入力の複雑さの傾向を把握できる。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time({service_name=~\"claude-code.*\"} | event_name=\"user_prompt\" | unwrap prompt_length | __error__=\"\" [$__rate_interval])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Input Tokens by Query Source",
      "description": "APIリクエストのクエリソース（query_source）別・入力トークン数の推移（event_name=api_request の input_tokens フィールド合計）。human / tool / system などの送信元ごとに集計。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
